@program gtk3-text-input-test
@compositor gnome
@conf hime-input-style=2
@conf hime-root-x=600
@conf hime-root-y=500
@conf hime-pop-up-win=0
@env HIME_CHECK_BACKGROUND=1000,700
# A password field: HIME's window goes away (IBus focuses the field and
# sets its purpose right after another focus out, which the daemon used to
# take for a repeat) and the keys go to it as they are.
--password b c @exec popup-shot.sh:1000,650:610,510
