@program gtk3-text-input-test
@compositor sway
@conf hime-input-style=1
@conf hime-root-x=600
@conf hime-root-y=500
@conf hime-pop-up-win=0
@env HIME_CHECK_BACKGROUND=1000,700
# OverSpot in an application with the HIME module: it does not use
# text-input, so there is no popup; the window stays at the fixed position.
--im hime b c @exec popup-shot.sh:610,510:60,70
