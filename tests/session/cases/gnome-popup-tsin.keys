@program gtk3-text-input-test
@compositor gnome
@method tsin
@conf hime-input-style=1
@conf hime-root-x=600
@conf hime-root-y=500
@conf hime-pop-up-win=0
@env HIME_CHECK_BACKGROUND=1000,700
# As wl-im-popup-tsin.keys, through GNOME's IBus (hime-ibus; HIME's window on Xwayland, below
# GNOME's top bar):
# tsin (詞音): its window follows the input style too, also when the style is
# switched while typing (the window is created again, and shown).
j @exec popup-shot.sh:60,115:610,510 @exec set-style.sh:2
j @exec popup-shot.sh:610,510:60,115 @exec set-style.sh:1
j @exec popup-shot.sh:60,115:610,510
