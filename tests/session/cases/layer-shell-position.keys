@compositor sway
@program layer-check.sh
@conf hime-input-style=2
@conf hime-root-x=100
@conf hime-root-y=200
@conf hime-pop-up-win=0
@env HIME_CHECK_BACKGROUND=1000,700
@env HIME_CHECK_POINTS=105,205 99,205 105,199 600,600
# On a compositor with layer-shell (sway) the daemon runs on Wayland and its
# input window is a layer surface at the fixed position (100,200): just
# inside the corner is the window, just outside and far away the background.
b
