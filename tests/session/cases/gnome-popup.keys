@program gtk3-text-input-test
@compositor gnome
@conf hime-input-style=1
@conf hime-root-x=600
@conf hime-root-y=500
@conf hime-pop-up-win=0
@env HIME_CHECK_BACKGROUND=1000,700
# As wl-im-popup.keys, through GNOME's IBus (hime-ibus; HIME's window on Xwayland, below
# GNOME's top bar):
# OverSpot: the input window of a text-input field is an input popup,
# which sway puts under the text cursor (the entry is at the top left),
# not at the fixed position (600,500).
b c @exec popup-shot.sh:60,120:610,510
