@program gtk3-text-input-test
@compositor gnome
@conf hime-input-style=1
@conf hime-root-x=600
@conf hime-root-y=500
@conf hime-pop-up-win=0
@env HIME_CHECK_BACKGROUND=1000,700
# As wl-im-popup-switch.keys, through GNOME's IBus (hime-ibus; HIME's window on Xwayland, below
# GNOME's top bar), except the end: on Xwayland the window is not created
# again, so the keys typed before a switch stay (space then types 三).
# Switching the input style (as hime-setup does) while typing: the window
# moves to the fixed position and back under the cursor.  The keys typed
# before a switch go with the old window (space then types a space).
b @exec popup-shot.sh:60,120:610,510 @exec set-style.sh:2
c @exec popup-shot.sh:610,510:60,120 @exec set-style.sh:1
<space> b @exec popup-shot.sh:60,120:610,510
