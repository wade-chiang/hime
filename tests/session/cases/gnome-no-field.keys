@program sequence.sh
@compositor gnome
@conf hime-input-style=1
@conf hime-root-x=600
@conf hime-root-y=500
@conf hime-pop-up-win=0
@env HIME_CHECK_BACKGROUND=1000,700
# Once the application is gone, IBus moves the engine to a fake input
# context of its own: no text field, so HIME's window goes away (it stayed,
# moved to the top left corner by the cursor GNOME Shell resets).
gtk3-text-input-test b c -- popup-shot.sh 1000,650 60,38 610,510
