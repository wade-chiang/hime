@program gtk3-text-input-test
@compositor gnome
@conf hime-input-style=2
@conf hime-root-x=600
@conf hime-root-y=500
@conf hime-pop-up-win=0
@env HIME_CHECK_BACKGROUND=1000,700
# As wl-im-popup-root.keys, through GNOME's IBus (hime-ibus; HIME's window on Xwayland, below
# GNOME's top bar):
# Root: the input window stays at the fixed position.
b c @exec popup-shot.sh:610,510:60,120
