@program gtk3-text-input-test
@compositor sway
@method pho
@conf hime-input-style=1
@conf hime-root-x=600
@conf hime-root-y=500
@conf hime-pop-up-win=0
@env HIME_CHECK_BACKGROUND=1000,700
# Zhuyin: its window follows the input style too, also when the style is
# switched while typing (the window is created again, and shown).
j @exec popup-shot.sh:60,70:610,510 @exec set-style.sh:2
j @exec popup-shot.sh:610,510:60,70 @exec set-style.sh:1
j @exec popup-shot.sh:60,70:610,510
